{
  "name": "plain-rich-editor",
  "version": "1.0.0",
  "description": "A rich text editor built with plain TypeScript, no external dependencies for core functionality",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:scss",
    "build:ts": "tsc",
    "build:scss": "sass src/styles/editor.scss dist/styles/editor.css",
    "build:prod": "npm run build && npm run minify",
    "minify": "node scripts/minify.js",
    "obfuscate": "node scripts/obfuscate.js",
    "build:secure": "npm run build && npm run obfuscate",
    "watch": "npm run watch:ts & npm run watch:scss",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass --watch src/styles/editor.scss:dist/styles/editor.css",
    "dev": "npm run build && node scripts/server.js",
    "dev:simple": "npm run build && python3 -m http.server 8000 || python -m SimpleHTTPServer 8000",
    "start": "node scripts/server.js",
    "start:prod": "npm run build:prod && node scripts/server.js",
    "start:secure": "npm run build:secure && node scripts/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prepublishOnly": "npm run build:prod"
  },
  "keywords": [
    "rich-text-editor",
    "text-editor",
    "wysiwyg",
    "typescript",
    "word-processor",
    "contenteditable",
    "editor",
    "rich-text",
    "html-editor"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "javascript-obfuscator": "^4.1.1",
    "sass": "^1.77.0",
    "terser": "^5.31.0",
    "typescript": "^5.3.3"
  }
}

